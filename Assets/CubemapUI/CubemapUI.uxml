<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="CubemapUI.uss" />
    <VisualElement name="root-container">
        <Label text="Cosmic Dome - Live Preview (UI Toolkit)" class="title-label" />
        
        <VisualElement class="grid-container">
            <VisualElement class="face-box">
                <Label text="Front" class="face-label" />
                <Image  name="cam-front" />
            </VisualElement>
            <VisualElement class="face-box">
                <Label text="Back" class="face-label" />
                <VisualElement name="cam-back" />
            </VisualElement>
            <VisualElement class="face-box">
                <Label text="Left" class="face-label" />
                <VisualElement name="cam-left" />
            </VisualElement>
            <VisualElement class="face-box">
                <Label text="Right" class="face-label" />
                <VisualElement name="cam-right" />
            </VisualElement>
            <VisualElement class="face-box">
                <Label text="Up" class="face-label" />
                <VisualElement name="cam-up" />
            </VisualElement>
            <VisualElement class="face-box">
                <Label text="Down" class="face-label" />
                <VisualElement name="cam-down" />
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>